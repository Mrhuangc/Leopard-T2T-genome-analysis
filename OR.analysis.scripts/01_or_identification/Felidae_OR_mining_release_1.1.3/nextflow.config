    withName: INTERPROSCAN_FUNCTIONAL_SMOKE {
        cpus = { Math.min(params.interproscan_smoke_cpus as int, params.max_cpus as int) }
        memory = 16.GB
        time = 90.min
        maxForks = 1
        errorStrategy = 'terminate'
        maxRetries = 0
        publishDir = [
            path: { "${params.outdir}/07_7tm_validation/interproscan/smoke/raw" },
