        }
        maxForks = 1
        errorStrategy = 'terminate'
        maxRetries = 0
        publishDir = [
            path: { "${params.outdir}/07_7tm_validation/interproscan/candidates" },
            mode: params.publish_mode,
            pattern: '*.{tsv,txt,log,yml}',
        ]
    }

    withName: FINALIZE_OR_CATALOG {
        publishDir = [
            path: { "${params.outdir}/08_final_OR_catalog" },
            mode: params.publish_mode,
            pattern: '*.{tsv,gff3,fa,json,yml}',
        ]
    }

    withName: FINAL_HOMOLOGY_BLAST {
        cpus = { Math.min(8, params.max_cpus as int) }
        memory = 16.GB
        time = { Math.min(4, params.max_time_h as int).h }
        maxForks = 1
        errorStrategy = 'terminate'
        maxRetries = 0
        publishDir = [
            path: { "${params.outdir}/09_NC_final_homology/blast" },
            mode: params.publish_mode,
            pattern: '*.{tsv,yml}',
        ]
    }

    withName: FINALIZE_NC_HOMOLOGY {
        publishDir = [
            path: { "${params.outdir}/09_NC_final_homology/catalog" },
            mode: params.publish_mode,
            pattern: '*.{tsv,gff3,fa,json,yml}',
        ]
    }

    withName: BUILD_SINGLE_EXON_CANDIDATES {
        cpus = 2
        memory = 16.GB
        time = 2.h
        maxForks = 1
        publishDir = [
            path: { "${params.outdir}/10_single_exon_nonfunctional/candidates" },
            mode: params.publish_mode,
            pattern: '*.{tsv,txt,fa,json,yml}',
        ]
    }

    withName: EXTRACT_SINGLE_EXON_TARGETS {
        publishDir = [
            path: { "${params.outdir}/10_single_exon_nonfunctional/targets" },
            mode: params.publish_mode,
            pattern: '*.{fa,json,yml}',
        ]
    }

    withName: SINGLE_EXON_TBLASTN_PILOT {
        cpus = { Math.min(params.single_exon_pilot_candidates as int, params.max_cpus as int) }
        memory = 8.GB
        time = 30.min
        maxForks = 1
        errorStrategy = 'terminate'
        maxRetries = 0
        publishDir = [
            path: { "${params.outdir}/10_single_exon_nonfunctional/pilot" },
            mode: params.publish_mode,
            pattern: '*.{ok,tsv,json,yml}',
        ]
    }

    withName: SINGLE_EXON_TBLASTN_SEARCH {
        cpus = { Math.min(params.single_exon_search_cpus as int, params.max_cpus as int) }
        memory = 16.GB
        time = {
            Math.min(
                params.single_exon_search_timeout_hours as int,
                params.max_time_h as int,
            ).h
        }
        maxForks = 1
        errorStrategy = 'terminate'
        maxRetries = 0
        publishDir = [
            path: { "${params.outdir}/10_single_exon_nonfunctional/targeted_tblastn" },
            mode: params.publish_mode,
            pattern: '*.{tsv,json,yml}',
        ]
    }

    withName: CLASSIFY_SINGLE_EXON_RECOVERY {
        publishDir = [
            path: { "${params.outdir}/10_single_exon_nonfunctional/classification" },
            mode: params.publish_mode,
            pattern: '*.{tsv,fa,json,yml}',
        ]
    }

    withName: BLASTX_SINGLE_EXON_RECOVERY {
        cpus = { Math.min(8, params.max_cpus as int) }
        memory = 16.GB
        time = 2.h
        maxForks = 1
        errorStrategy = 'terminate'
        maxRetries = 0
        publishDir = [
            path: { "${params.outdir}/10_single_exon_nonfunctional/blastx" },
            mode: params.publish_mode,
            pattern: '*.{tsv,yml}',
        ]
    }

    withName: BUILD_COMPLETE_OR_CATALOG {
        publishDir = [
            path: { "${params.outdir}/11_complete_OR_catalog" },
            mode: params.publish_mode,
            pattern: '*.{tsv,gff3,fa,json,yml}',
        ]
    }

    withName: MAFFT_ADD_OR_CLADES {
        cpus = { Math.min(8, params.max_cpus as int) }
        memory = 16.GB
        time = 2.h
        maxForks = 1
        publishDir = [
            path: { "${params.outdir}/12_OR_clade_classification/phylogeny" },
            mode: params.publish_mode,
            pattern: '*.{fa,log,yml}',
        ]
    }

    withName: FASTTREE_OR_CLADES {
        cpus = 1
        memory = 16.GB
        time = 2.h
        maxForks = 1
        publishDir = [
            path: { "${params.outdir}/12_OR_clade_classification/phylogeny" },
            mode: params.publish_mode,
            pattern: '*.{treefile,log,yml}',
        ]
    }

    withName: BLAST_OR_CLADES {
        cpus = { Math.min(8, params.max_cpus as int) }
        memory = 16.GB
        time = 2.h
        maxForks = 1
        publishDir = [
            path: { "${params.outdir}/12_OR_clade_classification/blast" },
            mode: params.publish_mode,
            pattern: '*.{tsv,yml}',
        ]
    }

    withName: CLASSIFY_OR_CLADES {
        publishDir = [
            path: { "${params.outdir}/12_OR_clade_classification/catalog" },
            mode: params.publish_mode,
            pattern: '*.{tsv,treefile,json,yml}',
        ]
    }

    withName: ANALYZE_OR_LOCUS_ARCHITECTURE {
        publishDir = [
            path: { "${params.outdir}/13_single_species_OR_analysis/architecture" },
            mode: params.publish_mode,
            pattern: '*.{tsv,json,yml}',
        ]
    }
}

executor {
    queueSize       = 100
    submitRateLimit = '20/1min'
}

profiles {
    standard {
        process.executor = 'local'
    }

    // Used only inside a Slurm allocation created by run_species_pipeline.sh.
    // A queue size of one keeps bundled processes strictly sequential and
    // prevents local execution from exceeding the cpus-per-task allocation.
    batch {
        process {
            executor = 'local'
            maxForks = 1

            // Fixed requests keep retries inside the enclosing Slurm allocation.
            withLabel: process_single {
                cpus = 1
                memory = 4.GB
                time = 2.h
            }
            withLabel: process_low {
                cpus = { Math.min(2, params.max_cpus as int) }
                memory = { Math.min(8, params.max_memory_gb as int).GB }
                time = { Math.min(4, params.max_time_h as int).h }
            }
            withLabel: process_medium {
                cpus = { Math.min(8, params.max_cpus as int) }
                memory = { Math.min(32, params.max_memory_gb as int).GB }
                time = { Math.min(12, params.max_time_h as int).h }
            }
            withLabel: process_high {
                cpus = { Math.min(16, params.max_cpus as int) }
                memory = { Math.min(64, params.max_memory_gb as int).GB }
                time = { Math.min(24, params.max_time_h as int).h }
            }
        }
        executor.queueSize = 1
    }

    slurm {
        process.executor       = 'slurm'
        process.queue          = params.slurm_partition
        process.clusterOptions = [
            params.slurm_account ? "--account=${params.slurm_account}" : null,
            params.slurm_qos ? "--qos=${params.slurm_qos}" : null,
        ].findAll { option -> option != null }.join(' ')
    }

    conda {
        conda.enabled  = true
        conda.useMamba = true
        conda.cacheDir = params.conda_cache_dir ?:
            System.getenv('NXF_CONDA_CACHEDIR') ?:
            "${System.getProperty('user.home')}/.cache/felidae-or/conda"
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }

}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
}

dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/workflow_dag.html"
}
