    withName: PREPARE_STRICT_REFINEMENT {
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/strict_refinement/pairs" },
            mode: params.publish_mode,
            pattern: '*.{tsv,json,yml}',
        ]
    }

    withName: EXONERATE_STRICT_PILOT {
        cpus = 1
        memory = 4.GB
        time = { ((params.strict_refinement_timeout_minutes as int) + 5).min }
        maxForks = params.strict_refinement_max_forks as int
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/strict_refinement/pilot_cells" },
            mode: params.publish_mode,
            pattern: '*.{txt,json,yml}',
        ]
    }

    withName: CHECK_STRICT_REFINEMENT_PILOT {
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/strict_refinement/pilot" },
            mode: params.publish_mode,
            pattern: '*.{ok,json,yml}',
        ]
    }

    withName: EXONERATE_STRICT_SEARCH {
        cpus = 1
        memory = 4.GB
        time = { ((params.strict_refinement_timeout_minutes as int) + 5).min }
        maxForks = params.strict_refinement_max_forks as int
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/strict_refinement/cells" },
            mode: params.publish_mode,
            pattern: '*.{txt,json,yml}',
        ]
    }

    withName: MERGE_STRICT_REFINEMENTS {
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/strict_refinement/merged" },
            mode: params.publish_mode,
            pattern: '*.{txt,json,yml}',
        ]
    }

    withName: CLASSIFY_MULTIEXON_MODELS {
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/classification" },
            mode: params.publish_mode,
            pattern: '*.{tsv,gff3,fa,json,yml}',
        ]
    }

    withName: BUILD_PRE7TM_CATALOG {
        publishDir = [
            path: { "${params.outdir}/06_OR_catalog/pre7tm" },
            mode: params.publish_mode,
            pattern: '*.{tsv,gff3,fa,json,yml}',
