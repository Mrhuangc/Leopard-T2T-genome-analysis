params {
    taxon_genus  = null
    taxon_species = null
    taxon_subspecies = null
    assembly_id  = null
    input_merged  = null
    genome        = null
    or_db         = null
    // Backward-compatible default: existing 1.1.2 parameter files reuse input_merged.
    // Set to generate for a new genome, or auto to prefer a supplied existing file.
    initial_search_mode           = 'reuse'
    initial_query_shards          = 2
    initial_tblastn_evalue        = 1e-5
    initial_tblastn_cpus          = 8
    initial_tblastn_max_forks     = 2
    initial_tblastn_timeout_hours = 24
    gpcr_db       = null
    outdir        = 'results'
    species       = null
    // 'link' uses same-filesystem hard links: no duplicate payload I/O and safe after work cleanup.
    // Use 'copy' only when work/ and outdir are on different filesystems.
    publish_mode  = 'link'
    conda_cache_dir = null
    max_cpus      = 32
    max_memory_gb = 128
    max_time_h    = 168
    slurm_partition = 'debug'
    slurm_account   = null
    slurm_qos       = null
    candidate_min_width = 100
    candidate_flank     = 1000
    min_orf_nt          = 750
    gpcr_blast_evalue   = 1e-5
    template_alignment  = null
    known_type1_ids     = null
    known_type2_ids     = null
    iqtree_model        = 'JTT+F+I+G4'
    iqtree_iterations   = 200
    iqtree_seed         = 20260806
    species_or_cluster_threshold = 500
    species_or_cluster_identity  = 0.90
    species_tblastn_evalue       = 1e-20
    max_hits_per_species_query   = 10000
    maximum_intron_length       = 10000
    confirmed_or_clearance      = 50
    exonerate_query_chunks      = 32
    exonerate_target_chunks     = 8
    exonerate_max_forks         = 6
    exonerate_exhaustive        = false
    exonerate_suboptimal        = false
    exonerate_smoke_exhaustive  = false
    exonerate_min_intron        = 50
    exonerate_top_queries_per_region = 3
    exonerate_pilot_pairs       = 6
    exonerate_pilot_min_positive_pairs = 3
    exonerate_soft_timeout_minutes = 5
    exonerate_smoke_timeout_minutes = 10
    maximum_or_exons             = 2
    exonerate_refinement_flank   = 600
    exonerate_model_blast_clearance = 50
    exonerate_min_reduced_blast_segment = 50
    strict_refinement_pilot_pairs     = 2
    strict_refinement_timeout_minutes = 5
    strict_refinement_max_forks       = 3
    multiexon_min_model_overlap       = 0.80
    multiexon_edge_distance           = 100
    multiexon_edge_n_window           = 200
    multiexon_edge_n_run              = 50
    interproscan_dir                  = null
    interproscan_version              = '5.78-109.0'
    interproscan_applications         = 'PrositeProfiles'
    interproscan_smoke_records        = 5
    interproscan_smoke_disable_precalc = true
    interproscan_smoke_cpus           = 4
    interproscan_expected_ipr         = 'IPR017452'
    interproscan_candidate_disable_precalc = true
    interproscan_candidate_cpus       = 8
    interproscan_candidate_timeout_hours = 6
    single_exon_catalog_clearance     = 100
    single_exon_recovery_flank        = 100
    single_exon_targeted_evalue       = 1e-20
    single_exon_pilot_candidates      = 5
    single_exon_pair_timeout_seconds  = 120
    single_exon_search_cpus           = 8
    single_exon_search_timeout_hours  = 4
    or_clade_db                       = null
    clade_blast_evalue                = 1e-5
    clade_minimum_tree_support        = 0.80
    or_operational_cluster_gap_bp     = 1000000
}

manifest {
    name            = 'Felidae_OR_mining'
    author          = 'Felidae OR mining project'
    description     = 'NC-compatible olfactory receptor gene-family mining for felids'
    version         = '1.1.3'
    nextflowVersion = '!>=24.10.0'
}

process {
    executor = 'local'
    shell    = ['/bin/bash', '-euo', 'pipefail']

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: process_single {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withLabel: process_low {
        cpus   = { Math.min(2 * task.attempt, params.max_cpus as int) }
        memory = { Math.min(8 * task.attempt, params.max_memory_gb as int).GB }
        time   = { Math.min(4 * task.attempt, params.max_time_h as int).h }
    }

    withLabel: process_medium {
        cpus   = { Math.min(8 * task.attempt, params.max_cpus as int) }
        memory = { Math.min(32 * task.attempt, params.max_memory_gb as int).GB }
        time   = { Math.min(12 * task.attempt, params.max_time_h as int).h }
    }

    withLabel: process_high {
        cpus   = { Math.min(16 * task.attempt, params.max_cpus as int) }
        memory = { Math.min(64 * task.attempt, params.max_memory_gb as int).GB }
        time   = { Math.min(24 * task.attempt, params.max_time_h as int).h }
    }

    withName: PREPARE_INITIAL_QUERIES {
        publishDir = [
            path: { "${params.outdir}/00_initial_search/queries" },
            mode: params.publish_mode,
            pattern: '*.{tsv,json,yml}',
        ]
    }

    // The database is intentionally kept only in the resumable work cache.
    // Publishing it would duplicate several GiB without adding audit value.
    withName: TBLASTN_INITIAL {
        cpus = { Math.min(params.initial_tblastn_cpus as int, params.max_cpus as int) }
        memory = { Math.min(16, params.max_memory_gb as int).GB }
        time = {
            Math.min(
                params.initial_tblastn_timeout_hours as int,
                params.max_time_h as int,
            ).h
        }
        maxForks = params.initial_tblastn_max_forks as int
        errorStrategy = 'terminate'
        maxRetries = 0
    }

    withName: MERGE_INITIAL_TBLASTN {
        publishDir = [
            path: { "${params.outdir}/00_initial_search/merged" },
            mode: params.publish_mode,
            pattern: '*.{tsv,json,yml}',
        ]
    }

    withName: VALIDATE_MERGED {
        publishDir = [
            path: { "${params.outdir}/03_OR_Finder_results/qc" },
            mode: params.publish_mode,
            pattern: '*.{json,yml}',
        ]
    }

    withName: BUILD_CANDIDATE_REGIONS {
        publishDir = [
            path: { "${params.outdir}/03_OR_Finder_results/candidate_regions" },
            mode: params.publish_mode,
            pattern: '*.{tsv,bed,txt,json,yml}',
        ]
    }

    withName: EXTRACT_CANDIDATE_SEQUENCES {
        publishDir = [
            path: { "${params.outdir}/03_OR_Finder_results/candidate_sequences" },
            mode: params.publish_mode,
            pattern: '*.{fa,json,yml}',
        ]
    }

    withName: GETORF {
        publishDir = [
            path: { "${params.outdir}/03_OR_Finder_results/getorf_raw" },
            mode: params.publish_mode,
            pattern: '*.{fa,yml}',
        ]
    }

    withName: NORMALIZE_GETORF {
        publishDir = [
            path: { "${params.outdir}/03_OR_Finder_results/orfs" },
            mode: params.publish_mode,
            pattern: '*.{fa,tsv,json,yml}',
        ]
    }

    withName: TRANSLATE_ORFS {
        publishDir = [
            path: { "${params.outdir}/03_OR_Finder_results/translation" },
            mode: params.publish_mode,
            pattern: '*.{fa,json,yml}',
        ]
    }

    withName: BLASTP_GPCR {
        publishDir = [
            path: { "${params.outdir}/03_OR_Finder_results/gpcr_blast" },
            mode: params.publish_mode,
            pattern: '*.{tsv,yml}',
        ]
    }

    withName: CLASSIFY_GPCR {
        publishDir = [
            path: { "${params.outdir}/03_OR_Finder_results/gpcr_classification" },
            mode: params.publish_mode,
            pattern: '*.{tsv,fa,txt,json,yml}',
        ]
    }

    withName: MAFFT_ADD {
        publishDir = [
            path: { "${params.outdir}/03_OR_Finder_results/phylogeny/alignment" },
            mode: params.publish_mode,
            pattern: '*.{fa,log,yml}',
        ]
    }

    withName: IQTREE_OR {
        publishDir = [
            path: { "${params.outdir}/03_OR_Finder_results/phylogeny/tree" },
            mode: params.publish_mode,
            pattern: '*.{treefile,iqtree,log,yml}',
        ]
    }

    withName: FILTER_OR_TREE {
        publishDir = [
            path: { "${params.outdir}/03_OR_Finder_results/phylogeny/filtered" },
            mode: params.publish_mode,
            pattern: '*.{fa,tsv,txt,treefile,json,yml}',
        ]
    }

    withName: NC_R_TREE_PARSER {
        publishDir = [
            path: { "${params.outdir}/03_OR_Finder_results/phylogeny/nc_r_parity" },
            mode: params.publish_mode,
            pattern: '*.{txt,treefile,json,yml}',
        ]
    }

    withName: PREPARE_SPECIES_OR_QUERIES {
        publishDir = [
            path: { "${params.outdir}/04_species_OR_expansion/queries" },
            mode: params.publish_mode,
            pattern: '*.{fa,clstr,txt,json,yml}',
        ]
    }

    withName: TBLASTN_SPECIES_OR {
        publishDir = [
            path: { "${params.outdir}/04_species_OR_expansion/tblastn" },
            mode: params.publish_mode,
            pattern: '*.{tsv,yml}',
        ]
    }

    withName: MERGE_SPECIES_TBLASTN {
        publishDir = [
            path: { "${params.outdir}/04_species_OR_expansion/merged" },
            mode: params.publish_mode,
            pattern: '*.{tsv,txt,json,yml}',
        ]
    }

    withName: BUILD_MULTIEXON_REGIONS {
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/candidate_regions" },
            mode: params.publish_mode,
            pattern: '*.{tsv,bed,txt,json,yml}',
        ]
    }

    withName: EXTRACT_MULTIEXON_SEQUENCES {
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/candidate_sequences" },
            mode: params.publish_mode,
            pattern: '*.{fa,json,yml}',
        ]
    }

    withName: PREPARE_EXONERATE_QUERIES {
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/queries" },
            mode: params.publish_mode,
            pattern: '*.{fa,json,yml}',
        ]
    }

    withName: PREPARE_EXONERATE_TARGETS {
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/targets" },
            mode: params.publish_mode,
            pattern: '*.{fa,json,yml}',
        ]
    }

    withName: PREPARE_TARGETED_EXONERATE {
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/targeted_pairs" },
            mode: params.publish_mode,
            pattern: '*.{tsv,json,yml}',
        ]
    }

    withName: EXONERATE_SMOKE {
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/toolchain" },
            mode: params.publish_mode,
            pattern: '*.{txt,yml}',
        ]
    }

    withName: PREPARE_EXONERATE_FUNCTIONAL_SMOKE {
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/smoke/inputs" },
            mode: params.publish_mode,
            pattern: '*.{fa,json}',
        ]
    }

    withName: EXONERATE_FUNCTIONAL_SMOKE {
        cpus = 1
        memory = 4.GB
        time = 20.min
        maxForks = 1
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/smoke/raw" },
            mode: params.publish_mode,
            pattern: '*.{txt,json,yml}',
        ]
    }

    withName: VALIDATE_EXONERATE_FUNCTIONAL_SMOKE {
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/smoke" },
            mode: params.publish_mode,
            pattern: '*.json',
        ]
    }

    withName: CHECK_EXONERATE_SMOKE_GATE {
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/smoke" },
            mode: params.publish_mode,
            pattern: '*.ok',
        ]
    }

    withName: EXONERATE_TARGETED_PILOT {
        cpus = 1
        memory = 4.GB
        time = 10.min
        maxForks = params.exonerate_max_forks as int
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/pilot_cells" },
            mode: params.publish_mode,
            pattern: '*.{txt,json,yml}',
        ]
    }

    withName: CHECK_EXONERATE_PILOT {
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/pilot" },
            mode: params.publish_mode,
            pattern: '*.{ok,json,yml}',
        ]
    }

    withName: EXONERATE_TARGETED_SEARCH {
        cpus = 1
        memory = 4.GB
        time = 10.min
        maxForks = params.exonerate_max_forks as int
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/targeted_cells" },
            mode: params.publish_mode,
            pattern: '*.{txt,json,yml}',
        ]
    }

    withName: MERGE_EXONERATE_RESULTS {
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/merged_targeted" },
            mode: params.publish_mode,
            pattern: '*.{txt,json,yml}',
        ]
    }

    withName: SELECT_EXONERATE_MODELS {
        publishDir = [
            path: { "${params.outdir}/05_multiexon_OR/exonerate/model_selection" },
            mode: params.publish_mode,
