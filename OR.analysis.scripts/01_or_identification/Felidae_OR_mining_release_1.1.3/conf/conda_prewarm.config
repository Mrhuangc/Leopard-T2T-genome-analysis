process {
    executor = 'local'
    maxForks = 1
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'
    maxRetries = 0
}

executor {
    queueSize = 1
}

conda {
    enabled = true
    useMamba = true
    cacheDir = System.getenv('NXF_CONDA_CACHEDIR')
}

report.enabled = false
timeline.enabled = false
trace.enabled = false
dag.enabled = false
